# Phase 4 deployment environment (TESTNET ONLY — your funded Sepolia wallet).
#
# Copy to .env and fill in values. NEVER commit this file or paste real
# private keys anywhere else.

# Sepolia public RPC (can be swapped for an Alchemy/Infura keyed endpoint).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The wallet that deploys & administers the Guardian contracts and holds the
# gTEST used for the wallet-signed E2E. Must be funded with Sepolia ETH.
# This is a PRIVATE KEY — keep it in .env only. Format: 0x...
PRIVATE_KEY=0x...

# Optional: etherscan key for -file:--verify on Sepolia. Not required.
ETHERSCAN_API_KEY=