# AI Guardian backend configuration
# Copy to .env and adjust for your machine. Never commit real credentials.

# HTTP server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Default Homebrew postgres uses your macOS username with no password.
DATABASE_URL=postgres://jeffery@localhost:5432/ai_guardian

# Redis cache
REDIS_URL=redis://127.0.0.1:6379

# CORS - the frontend origin(s) allowed to call this API
CORS_ORIGIN=\

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# KeeperHub Execution (Phase 5)
# Set KEEPERHUB_API_KEY (starts with kh_) to enable KeeperHub-controlled
# execution; leave empty to use direct (wallet-signed) execution.
KEEPERHUB_API_KEY=
# KeeperHub's public execution wallet address (must hold Sepolia ETH + the
# test token being deposited). Never put a private key in .env.
KEEPERHUB_WALLET_ADDRESS=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_SIMULATE_FIRST=true
KEEPERHUB_POLL_MAX_ATTEMPTS=30
KEEPERHUB_POLL_INTERVAL_MS=5000

# Phase 6 — execution policy + pre-flight gates
# When true, a workflow REQUIRES a real KeeperHub key: without one the
# service refuses to run (no silent fallback to direct execution).
KEEPERHUB_EXECUTION_REQUIRED=false
# When true, every KeeperHub execution first proves on-chain that the
# KeeperHub wallet has enough gas + the requested asset/allocation.
KEEPERHUB_PREFLIGHT_FUNDING=true
# Minimum Sepolia ETH (wei) the KeeperHub wallet must hold before execution.
KEEPERHUB_MIN_GAS_WEI=10000000000000000

# Phase 4/6 deployment (NEVER commit secrets; export or use an untracked env):
#   PRIVATE_KEY=          # deployer account, funded with Sepolia ETH
#   SEPOLIA_RPC_URL=      # Sepolia RPC endpoint
#   ETHERSCAN_API_KEY=    # for --verify after deployment

# Cache TTLs (seconds)
OPPORTUNITY_CACHE_TTL=60
RANKING_CACHE_TTL=300